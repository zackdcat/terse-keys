{
  "name": "terse-keys",
  "displayName": "terse-keys",
  "description": "Keybinds that make it faster to type code constructs.",
  "publisher": "zackdcat",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zackdcat/terse-keys"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "terse-keys.binds",
        "title": "Terse: Binds"
      }
    ],
    "keybindings": [
      {
        "command": "terse-keys.binds",
        "key": "alt+v",
        "when": "editorTextFocus",
        "args": "variableShortcut"
      },
      {
        "command": "terse-keys.binds",
        "key": "alt+c",
        "when": "editorTextFocus",
        "args": "constVariableShortcut"
      },
      {
        "command": "terse-keys.binds",
        "key": "alt+f",
        "when": "editorTextFocus",
        "args": "functionShortcut"
      },
      {
        "command": "terse-keys.binds",
        "key": "alt+i",
        "when": "editorTextFocus",
        "args": "ifShortcut"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
